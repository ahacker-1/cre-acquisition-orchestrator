{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRE agent conversation response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "citations",
    "confidence",
    "unanswered",
    "followUpSuggestions"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "citations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentId", "location", "excerpt"],
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "unanswered": {
      "type": "boolean"
    },
    "followUpSuggestions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    }
  }
}
